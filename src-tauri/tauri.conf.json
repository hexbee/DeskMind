{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": false
  },
  "productName": "DeskMind",
  "version": "0.1.3",
  "identifier": "com.example.deskmind",
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "DeskMind",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": false,
        "maximizable": true,
        "minimizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": false
    }
  }
}