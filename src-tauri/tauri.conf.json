{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "Copyright © 2025 DeskMind",
    "category": "Productivity",
    "shortDescription": "AI Chat Desktop Client",
    "longDescription": "An open-source desktop AI chat client built with Tauri and React.js",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": null,
      "nsis": null
    }
  },
  "productName": "DeskMind",
  "version": "0.1.3",
  "identifier": "com.example.deskmind",
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "DeskMind",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": false,
        "maximizable": true,
        "minimizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": false
    }
  }
}